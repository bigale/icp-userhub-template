{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../frontend/src/*"],
      "@ext/*": ["./src/*"]
    },
    "baseUrl": "."
  },
  "include": ["src", "../frontend/src"]
}
